import { PadNoticeCard } from "components/pad_notice.slint";
import "../../../assets/fonts/Manrope-Regular.ttf";
import "../../../assets/fonts/Manrope-Medium.ttf";
import "../../../assets/fonts/Manrope-SemiBold.ttf";

import { Theme } from "theme.slint";
import { UiAction, InputMap } from "input.slint";
import { HomeData, SettingsData, Status, PadNotice, Session, HomeTile, TileKind, SettingsCategory, WifiRow, GameProperties } from "data.slint";
import { Home } from "home.slint";
import { SettingsScreen } from "settings/settings.slint";
import { Placeholder } from "placeholder.slint";
import { OverlayWindow, OverlayPanel } from "overlay/window.slint";
import { Toast } from "components/toast.slint";
import { NoticeCard } from "components/notice.slint";
import { ConfirmDialog } from "components/dialog.slint";
import { ControllerType } from "components/glyphs.slint";
import { ControlsScreen } from "controls/screen.slint";
import { ControlsData, Callout, Choice, OptionRow } from "controls/data.slint";

export { Theme, ControllerType, OverlayWindow, OverlayPanel, HomeData, SettingsData, Status, PadNotice, Session, HomeTile, TileKind, SettingsCategory, WifiRow, GameProperties, ControlsData, Callout, Choice, OptionRow }

enum Screen { home, settings, placeholder, controls, button-test }

export component AppWindow inherits Window {
    title: "Hearth";
    preferred-width: 1280px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 360px;
    background: Theme.bg-base;
    default-font-family: "Manrope";

    property <Screen> screen: Screen.home;
    // "Close <game>?" before starting another game: 0 Close and play, 1 Cancel (the default).
    property <bool> switch-open: Session.switch-open;
    property <int> switch-index: 1;
    changed switch-open => { switch-index = 1; }

    // Where Back on the controls page returns (Settings or Home).
    property <Screen> controls-return: Screen.settings;

    function update-scale() {
        Theme.scale = min(self.width / 1920px, self.height / 1080px);
    }

    init => {
        update-scale();
        scope.focus();
    }
    changed width => { update-scale(); }
    changed height => { update-scale(); }

    // Shows Home, closing whatever screen is open. Focus goes to the first game (`focus-game`:
    // the running game, or the one that just ended) or to Welcome.
    public function go-home(focus-game: bool) {
        screen = Screen.home;
        home.reset(focus-game);
    }

    // Shows the controls page (ControlsData filled by Rust), returning to the current screen.
    public function open-controls() {
        controls-return = screen == Screen.home ? Screen.home : Screen.settings;
        controls.reset();
        screen = Screen.controls;
    }

    // Button test: input is handled by Rust (a long Guide press closes it).
    public function open-button-test() {
        screen = Screen.button-test;
    }
    public function close-button-test() {
        screen = Screen.settings;
    }

    function handle-switch(action: UiAction) -> bool {
        if action == UiAction.left { switch-index = 0; }
        if action == UiAction.right { switch-index = 1; }
        if action == UiAction.back { Session.switch-open = false; }
        if action == UiAction.accept {
            Session.switch-open = false;
            if switch-index == 0 { Session.confirm-switch(); }
        }
        true
    }

    // Every key (and every controller action, injected as a key) goes through here.
    function dispatch(action: UiAction) -> bool {
        if action == UiAction.none {
            return false;
        }
        // The Guide button belongs to the session logic in Rust (overlay, Home, close).
        if action == UiAction.home-short || action == UiAction.home-long {
            Session.switch-open = false;
            Session.home-button(action == UiAction.home-long);
            return true;
        }
        if Session.switch-open {
            return handle-switch(action);
        }
        if screen == Screen.settings {
            return settings.handle(action);
        }
        if screen == Screen.controls {
            return controls.handle(action);
        }
        if screen == Screen.button-test {
            return true;
        }
        if screen == Screen.placeholder {
            if action == UiAction.back {
                screen = Screen.home;
                return true;
            }
            return false;
        }
        home.handle(action)
    }

    forward-focus: scope;
    scope := FocusScope {
        key-pressed(event) => {
            root.dispatch(InputMap.from-key(event)) ? EventResult.accept : EventResult.reject
        }

        home := Home {
            open-settings => {
                settings.reset();
                screen = Screen.settings;
            }
            open-placeholder(heading, text) => {
                placeholder.heading = heading;
                placeholder.text = text;
                screen = Screen.placeholder;
            }
        }

        settings := SettingsScreen {
            opacity: screen == Screen.settings ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Theme.base; easing: ease-out; }
            close => { screen = Screen.home; }
        }

        controls := ControlsScreen {
            opacity: screen == Screen.controls ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Theme.base; easing: ease-out; }
            close => { screen = controls-return; }
        }

        // The button test: the controls page's layout with live input.
        ControlsScreen {
            test-mode: true;
            opacity: screen == Screen.button-test ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Theme.base; easing: ease-out; }
        }

        placeholder := Placeholder {
            opacity: screen == Screen.placeholder ? 1 : 0;
            visible: self.opacity > 0;
            animate opacity { duration: Theme.base; easing: ease-out; }
        }

        if Session.switch-open: ConfirmDialog {
            width: parent.width;
            height: parent.height;
            heading: "Close " + Session.switch-from + "?";
            message: "Unsaved progress will be lost.";
            confirm-label: "Close and play " + Session.switch-to;
            index: switch-index;
        }

        Toast {
            x: (parent.width - self.width) / 2;
            y: parent.height - Theme.safe-y - Theme.sp-96 - self.height
                - (Status.notice-title != "" ? notice.height : 0);
        }
        notice := NoticeCard {
            x: (parent.width - self.width) / 2;
            y: parent.height - Theme.safe-y - self.height;
        }
        // Controller notices, bottom right, over everything else.
        PadNoticeCard {
            x: parent.width - Theme.safe-x - self.width;
            y: parent.height - Theme.safe-y - self.height;
        }
    }
}
