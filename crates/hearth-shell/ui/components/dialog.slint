import { Theme } from "../theme.slint";
import { HButton } from "button.slint";

// Modal confirmation: scrim, centered card, a danger action and Cancel. The owner handles
// navigation; `index` 0 is the action, 1 is Cancel.
export component ConfirmDialog inherits Rectangle {
    in property <string> heading;
    in property <string> message;
    in property <string> confirm-label;
    in property <int> index;

    background: Theme.scrim;

    Rectangle {
        // At least 720, wider when the buttons need it ("Close and play <long title>").
        width: min(max(720px * Theme.scale, buttons.preferred-width + 2 * Theme.sp-48),
            root.width - 2 * Theme.safe-x);
        height: layout.preferred-height;
        border-radius: Theme.radius-lg;
        background: Theme.surface-raised;

        layout := VerticalLayout {
            padding: Theme.sp-48;
            spacing: Theme.sp-24;
            Text {
                text: heading;
                font-size: Theme.title;
                font-weight: Theme.semibold;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            Text {
                text: message;
                font-size: Theme.body;
                color: Theme.text-secondary;
                wrap: word-wrap;
            }
            buttons := HorizontalLayout {
                padding-top: Theme.sp-16;
                spacing: Theme.sp-16;
                alignment: start;
                HButton {
                    label: confirm-label;
                    danger: true;
                    focused: index == 0;
                }
                HButton {
                    label: "Cancel";
                    focused: index == 1;
                }
            }
        }
    }
}
