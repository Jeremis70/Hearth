import { Theme } from "../theme.slint";
import { ButtonGlyph } from "glyphs.slint";

// `input` (and `input2`, e.g. "l1" + "r1" for tabs) are Hearth pad positions, drawn as the
// connected controller's buttons.
export struct Hint {
    input: string,
    input2: string,
    label: string,
}

// Bottom-right button hints.
export component HintBar inherits HorizontalLayout {
    in property <[Hint]> hints;
    spacing: Theme.sp-32;
    alignment: end;
    for hint in hints: HorizontalLayout {
        spacing: Theme.sp-8;
        ButtonGlyph {
            input: hint.input;
            tint: Theme.text-secondary;
            size: 32px * Theme.scale;
        }
        if hint.input2 != "": ButtonGlyph {
            input: hint.input2;
            tint: Theme.text-secondary;
            size: 32px * Theme.scale;
        }
        Text {
            text: hint.label;
            vertical-alignment: center;
            font-size: Theme.caption;
            font-weight: Theme.medium;
            color: Theme.text-secondary;
        }
    }
}
