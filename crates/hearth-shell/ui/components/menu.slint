import { Theme } from "../theme.slint";
import { FocusRing } from "focus.slint";

// Options menu for a tile (Play / Resume / Close game). The owner handles navigation.
export component OptionsMenu inherits Rectangle {
    in property <[string]> items;
    in property <int> index;

    width: 420px * Theme.scale;
    height: layout.preferred-height;
    border-radius: Theme.radius-lg;
    background: Theme.surface-raised;
    drop-shadow-blur: Theme.sp-32;
    drop-shadow-color: #00000080;

    layout := VerticalLayout {
        padding: Theme.sp-12;
        spacing: Theme.sp-4;
        for item[i] in items: Rectangle {
            height: Theme.row-height * 0.8;
            border-radius: Theme.radius-md;
            background: i == index ? Theme.surface : transparent;
            Text {
                x: Theme.sp-24;
                text: item;
                vertical-alignment: center;
                font-size: Theme.body-lg;
                font-weight: Theme.medium;
                color: item == "Close game" ? Theme.danger : Theme.text-primary;
            }
            FocusRing {
                shown: i == index;
            }
        }
    }
}
