import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { FocusRing } from "focus.slint";

// One menu entry. `checked` shows a check mark (toggles such as Favorite).
export struct MenuItem {
    key: string,
    label: string,
    checked: bool,
    danger: bool,
}

// Options menu for a tile (Play or Close game, Controls, Favorite, Properties). The owner
// handles navigation.
export component OptionsMenu inherits Rectangle {
    in property <[MenuItem]> items;
    in property <int> index;

    width: 460px * Theme.scale;
    height: layout.preferred-height;
    border-radius: Theme.radius-lg;
    background: Theme.surface-raised;
    drop-shadow-blur: Theme.sp-32;
    drop-shadow-color: #00000080;

    layout := VerticalLayout {
        padding: Theme.sp-12;
        spacing: Theme.sp-4;
        for item[i] in items: Rectangle {
            height: Theme.row-height * 0.8;
            border-radius: Theme.radius-md;
            background: i == index ? Theme.surface : transparent;
            HorizontalLayout {
                padding-left: Theme.sp-24;
                padding-right: Theme.sp-24;
                spacing: Theme.sp-16;
                Text {
                    text: item.label;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                    font-size: Theme.body-lg;
                    font-weight: Theme.medium;
                    color: item.danger ? Theme.danger : Theme.text-primary;
                }
                if item.checked: Image {
                    source: Icons.check;
                    width: Theme.icon-size * 0.8;
                    height: self.width;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.accent;
                }
            }
            FocusRing {
                shown: i == index;
            }
        }
    }
}
