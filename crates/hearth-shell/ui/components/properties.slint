import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { GameProperties } from "../data.slint";
import { ListRow } from "list_row.slint";
import { FocusRing } from "focus.slint";

component Field inherits HorizontalLayout {
    in property <string> label;
    in property <string> value;
    in property <bool> disabled: false;
    spacing: Theme.sp-24;
    Text {
        text: label;
        width: 240px * Theme.scale;
        font-size: Theme.body;
        color: disabled ? Theme.text-disabled : Theme.text-secondary;
    }
    Text {
        text: value;
        horizontal-stretch: 1;
        wrap: word-wrap;
        font-size: Theme.body;
        font-weight: Theme.medium;
        color: disabled ? Theme.text-disabled : Theme.text-primary;
    }
}

component Action inherits Rectangle {
    in property <image> icon;
    in property <string> label;
    in property <bool> focused;
    height: Theme.row-height;
    border-radius: Theme.radius-md;
    background: focused ? Theme.surface : transparent;
    ListRow {
        height: parent.height;
        icon: icon;
        label: label;
        trailing-icon: Icons.chevron-right;
        has-trailing-icon: true;
        show-divider: false;
    }
    FocusRing { shown: focused; }
}

// Facts about a game, then its customization (Artwork, Theme music, Wrong game?: `index`).
// The owner handles navigation; Back closes it.
export component PropertiesPanel inherits Rectangle {
    in property <GameProperties> data;
    in property <int> index;

    background: Theme.scrim;

    Rectangle {
        width: 1080px * Theme.scale;
        height: layout.preferred-height;
        border-radius: Theme.radius-lg;
        background: Theme.surface-raised;

        layout := VerticalLayout {
            padding: Theme.sp-48;
            spacing: Theme.sp-16;
            Text {
                text: data.title;
                font-size: Theme.title;
                font-weight: Theme.semibold;
                color: Theme.text-primary;
                wrap: word-wrap;
            }
            Rectangle { height: Theme.sp-8; }
            Field { label: "Console"; value: data.console; }
            Field { label: "File"; value: data.path; }
            Field { label: "Size"; value: data.size; }
            Field { label: "Artwork match"; value: data.match-name; }
            Rectangle {
                height: 1px;
                background: Theme.divider;
            }
            Action { icon: Icons.image; label: "Artwork"; focused: index == 0; }
            Action { icon: Icons.music; label: "Theme music"; focused: index == 1; }
            Action { icon: Icons.help; label: "Wrong game?"; focused: index == 2; }
        }
    }
}
