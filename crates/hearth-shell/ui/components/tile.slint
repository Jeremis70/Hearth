import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { HomeTile, TileKind } from "../data.slint";
import { FocusRing } from "focus.slint";

// Square home-row tile. `current` makes it large (it stays large while focus is in the hero
// zone, like the PS5); `focused` draws the focus ring. Shows the game's grid art, or a
// gradient with the title until there is some.
export component Tile inherits Rectangle {
    in property <HomeTile> data;
    in property <bool> current;
    in property <bool> focused;

    width: current ? Theme.tile-focused : Theme.tile;
    height: self.width;
    animate width { duration: Theme.base; easing: ease-out; }
    opacity: current ? 1 : 0.85;
    border-radius: Theme.radius-lg;

    // Placeholder gradient (with the title) until the game has art; consoles are never shown
    // on tiles (Home puts the icon beside the focused one).
    Rectangle {
        border-radius: Theme.radius-lg;
        clip: true;
        background: @linear-gradient(135deg, data.art-a 0%, data.art-b 100%);

        if data.kind == TileKind.game && data.art.width == 0: Text {
            x: root.width * 0.09;
            y: root.width * 0.08;
            width: root.width * 0.82;
            text: data.title;
            wrap: word-wrap;
            font-size: root.width / 8;
            font-weight: Theme.semibold;
            color: #F7F3EEE0;
        }

        if data.art.width > 0: Image {
            width: parent.width;
            height: parent.height;
            source: data.art;
            image-fit: cover;
        }

        if data.kind != TileKind.game: Image {
            width: root.width * 0.36;
            height: self.width;
            source: data.kind == TileKind.library ? Icons.library
                : data.kind == TileKind.media ? Icons.clapperboard : Icons.settings;
            colorize: Theme.text-primary;
        }
    }

    // Running game: `success` dot in the top-right corner.
    if data.running: Rectangle {
        width: Theme.sp-16;
        height: self.width;
        x: parent.width - self.width - Theme.sp-12;
        y: Theme.sp-12;
        border-radius: self.width / 2;
        background: Theme.success;
        border-width: 2px;
        border-color: #00000080;
    }

    FocusRing {
        shown: focused;
        radius: Theme.radius-lg;
    }
}
