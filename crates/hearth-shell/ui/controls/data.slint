// The controls page's data (src/bridge/controls_page.rs fills it). A global per window: the
// main window and the overlay each have their own copy.

// One input's callout on the Buttons tab. Geometry is in page pixels at 1920×1080
// (src/callouts.rs); the page multiplies it by Theme.scale.
export struct Callout {
    input: string,      // Hearth pad position ("south", "dpad_up", "left_stick")
    label: string,      // what it does on this console ("A", "Fast-forward (hold)"), "—" if nothing
    hint: string,       // one line for the description panel
    unassigned: bool,
    changed: bool,      // differs from the layer below (accent dot)
    side: int,          // 0 left column, 1 right column, 2 below the drawing
    glyph-last: bool,   // label then glyph (glyph nearest the drawing)
    bx: float,          // the callout's box
    by: float,
    bw: float,
    bh: float,
    has-line: bool,     // leader line: label edge (lx, ly) → elbow (ex, ey) → shape edge (ax, ay)
    lx: float,
    ly: float,
    ex: float,
    ey: float,
    ax: float,
    ay: float,
    // Button test: `label` is the live state after the input's name (" · 43 %").
    held: bool,         // pressed (lit like the focused callout)
    bar: float,         // trigger travel 0..1, -1: no bar
    has-dot: bool,      // stick position dot at (dot-x, dot-y), page pixels
    dot-x: float,
    dot-y: float,
}

// One entry of the "what can this button do" menu.
export struct Choice {
    id: string,         // target as written in controls files ("Z", "@fast_forward_hold", "none")
    label: string,
    hint: string,
    current: bool,
}

// One row of the Sticks & options tab.
export struct OptionRow {
    id: string,
    label: string,
    value: string,
    hint: string,
    changed: bool,
    kind: int,          // 0 toggle, 1 stepper (left/right), 2 action (reset)
}

export global ControlsData {
    in property <string> title;             // "GameCube"
    in property <string> scope-line;        // "All GameCube games" / "Twilight Princess only"
    in property <string> note;              // "Applies next time you start the game"
    in property <string> message;           // short feedback ("Z and R swapped"), empty: none
    in property <string> changed-label;     // what the dot means on this page
    in property <string> reset-message;     // what Reset goes back to
    in property <float> draw-x;              // the drawing on the controls page, page pixels
    in property <float> draw-y;
    in property <float> draw-w;
    in property <float> draw-h;
    in property <[Callout]> callouts;       // left column, then right column, then bottom row
    in property <int> left-count;
    in property <int> right-count;
    in property <int> down-left;            // bottom callout reached going down from each column
    in property <int> down-right;
    in property <[Choice]> choices;
    in property <[OptionRow]> options;

    // Fills `choices` for `input`; returns the index of its current target.
    callback request-choices(/* input */ string) -> int;
    callback choose(/* input */ string, /* choice id */ string);
    // step: -1/+1 for steppers and toggles, 0 to activate (toggle, reset).
    callback change-option(/* id */ string, /* step */ int);
    callback closed();
}
