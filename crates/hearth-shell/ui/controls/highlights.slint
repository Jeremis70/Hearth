// Per-input highlight images (assets/controllers/generic/<id>.svg, generated from the drawing
// by the `every_input_has_a_highlight_matching_the_drawing` test): the exact shape of an input,
// white, the size of the whole drawing. Keep in sync with that folder (the test checks).
export global Highlights {
    // The highlight for Hearth pad input `input`, or an empty image.
    public pure function image(input: string) -> image {
        if input == "l2" { return @image-url("../../../../assets/controllers/generic/l2.svg"); }
        if input == "r2" { return @image-url("../../../../assets/controllers/generic/r2.svg"); }
        if input == "l1" { return @image-url("../../../../assets/controllers/generic/l1.svg"); }
        if input == "r1" { return @image-url("../../../../assets/controllers/generic/r1.svg"); }
        if input == "dpad_up" { return @image-url("../../../../assets/controllers/generic/dpad_up.svg"); }
        if input == "dpad_down" { return @image-url("../../../../assets/controllers/generic/dpad_down.svg"); }
        if input == "dpad_left" { return @image-url("../../../../assets/controllers/generic/dpad_left.svg"); }
        if input == "dpad_right" { return @image-url("../../../../assets/controllers/generic/dpad_right.svg"); }
        if input == "north" { return @image-url("../../../../assets/controllers/generic/face_north.svg"); }
        if input == "south" { return @image-url("../../../../assets/controllers/generic/face_south.svg"); }
        if input == "west" { return @image-url("../../../../assets/controllers/generic/face_west.svg"); }
        if input == "east" { return @image-url("../../../../assets/controllers/generic/face_east.svg"); }
        if input == "left_stick" { return @image-url("../../../../assets/controllers/generic/ls.svg"); }
        if input == "l3" { return @image-url("../../../../assets/controllers/generic/l3.svg"); }
        if input == "right_stick" { return @image-url("../../../../assets/controllers/generic/rs.svg"); }
        if input == "r3" { return @image-url("../../../../assets/controllers/generic/r3.svg"); }
        if input == "select" { return @image-url("../../../../assets/controllers/generic/select.svg"); }
        if input == "start" { return @image-url("../../../../assets/controllers/generic/start.svg"); }
        return @image-url("");
    }
}
