// Data the Rust side provides, and callbacks it handles. Kept in globals so screens don't
// need properties threaded through AppWindow.

// Home row cells: Welcome (first), games, Game Library (last).
export enum TileKind { welcome, game, library }

export struct HomeTile {
    id: string,
    title: string,
    badge: string,      // console short name, games only
    subtitle: string,   // "12 h played · last played yesterday" or a description
    last-played: string, // "last played yesterday"; empty if never played
    played: string,     // playtime pill: "Played 12 h", "Not played yet"
    kind: TileKind,
    art-a: color,       // placeholder art gradient
    art-b: color,
    running: bool,      // this game's session is running (frozen or not)
    favorite: bool,
    // Art; empty images (width 0) mean "not there": placeholders are drawn instead.
    art: image,         // square grid
    hero: image,        // sharp banner for the hero zone
    logo: image,        // shown instead of the title
    // Console icon from the selected pack or Hearth's glyphs (tinted), else `monogram`.
    console-icon: image,
    console-icon-tint: bool,
    monogram: string,
}

// Properties of one game (Home → Options → Properties), filled by Rust on request.
export struct GameProperties {
    title: string,
    console: string,
    path: string,
    size: string,
    match-name: string, // SteamGridDB game it matched, or why there is none
}

export struct SettingsCategory {
    key: string,
    label: string,
    status: string,
}

// Settings → Display & sound, below the pack rows: a volume (`slider`, 0–100 in steps of 10)
// or an on/off option.
export struct AudioRow {
    key: string,      // ui_volume, music_volume, mute, music_in_overlay, game_themes
    label: string,
    slider: bool,
    value: int,       // sliders
    on: bool,         // toggles
}

// A connected controller (Settings → Controllers).
export struct PadRow {
    id: string,
    name: string,       // "DualSense"
    connection: string, // "USB", "Bluetooth" or ""
    battery: int,       // percent, -1 when not reported (or wired)
    charging: bool,
}

export struct WifiRow {
    ssid: string,
    strength: int,      // 0-100
    secured: bool,
    connected: bool,
}

export global HomeData {
    in property <[HomeTile]> tiles;
    in property <GameProperties> properties;
    // Actions not implemented yet (play, options, search, widgets) are reported here.
    callback activated(/* what */ string, /* id */ string);
    callback toggle-favorite(/* game id */ string);
    // The focused cell of the row (art for it is decoded first).
    callback focus-changed(/* index */ int);
    // The game whose theme may play: the focused game while Home's Games row shows, else "".
    callback music-focus-changed(/* game id */ string);
    // A game's own controls page (running or not).
    callback open-game-controls(/* game id */ string);
    // Fills `properties` (synchronously) for a game.
    callback request-properties(/* game id */ string);
}

export global SettingsData {
    in property <[SettingsCategory]> categories;
    in property <[WifiRow]> wifi;
    callback wifi-selected(/* ssid */ string);
    // Controllers: the connected pads, then one row per console with controls (key
    // "system:<id>", status "Default" / "Customized"). `controller-item` opens a page:
    // "system:<id>" a console's controls, "test:<pad id>" a pad's button test.
    in property <[PadRow]> pads;
    in property <[SettingsCategory]> controller-items;
    callback controller-item(/* key */ string);
    // Display & sound: one row per pack category (key "console_icons" / "ui_sounds", status
    // = the selected pack's name), then that category's choices (key = pack id, "" for Hearth
    // default; label = name; status = author) with the selected one in `pack-selected`.
    in property <[SettingsCategory]> display-items;
    in property <[SettingsCategory]> pack-choices;
    in property <string> pack-selected;
    callback open-packs(/* category key */ string);
    callback choose-pack(/* category key */ string, /* pack id */ string);
    in property <[AudioRow]> audio-rows;
    // A volume step (-1/+1) or a toggle (0); applies at once and is saved.
    callback audio-change(/* key */ string, /* step */ int);
}

export global Status {
    in property <string> clock;
    in property <string> greeting;  // "Good evening", for the Welcome cell
    in property <string> controller-battery;    // top bar: "85 %", or empty
    // Controllers widget on Welcome: "1 connected" and "DualSense · 85 %".
    in property <string> pads-value: "None connected";
    in property <string> pads-detail: "Connect a controller";
    in property <string> toast;     // empty: hidden
    // A problem Hearth worked around (e.g. hearth.toml unreadable); empty title: hidden.
    in property <string> notice-title;
    in property <string> notice-text;
}

// A controller notice (battery low, connected, disconnected): a small card in a corner for a
// few seconds, never pausing anything. Set by the session in both windows.
export global PadNotice {
    in property <bool> shown;
    in property <string> text;
    // The controller's name or "15 %".
    in property <string> detail;
    // Battery percent shown with its icon; -1: no battery icon (connect/disconnect).
    in property <int> battery: -1;
}

// The running game, and the actions that control it (handled in src/bridge/session.rs).
export global Session {
    in property <bool> active;
    in property <string> title;
    in property <string> badge;
    in property <string> played;    // "Playing for 12 min"
    callback launch(/* game id */ string);
    // Starting a game while another runs: Rust opens the dialog (titles filled in); the UI
    // closes it, calling confirm-switch() when the user chose "Close and play".
    in-out property <bool> switch-open;
    in property <string> switch-from;
    in property <string> switch-to;
    callback confirm-switch();
    callback resume();
    callback close-game();
    // The running game's controls page.
    callback open-controls();
    // Guide button pressed on the keyboard (F1 short / F2 long); controller presses don't
    // come through here.
    callback home-button(/* long */ bool);
}
