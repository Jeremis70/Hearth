import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { UiAction } from "input.slint";
import { HomeData, HomeTile, TileKind, Session } from "data.slint";
import { Tile } from "components/tile.slint";
import { TopBar } from "components/top_bar.slint";
import { HButton } from "components/button.slint";
import { Widget } from "components/widget.slint";
import { HintBar } from "components/hint_bar.slint";
import { OptionsMenu, MenuItem } from "components/menu.slint";
import { PropertiesPanel } from "components/properties.slint";
import { ConfirmDialog } from "components/dialog.slint";

export enum HomeZone { topbar, row, hero, widgets }

// One background layer for a tile: the sharp hero across the top at its own aspect ratio,
// fading into the pre-blurred hero (stretched over the whole screen, behind the widgets).
// Without art, the tile's placeholder gradient.
component Backdrop inherits Rectangle {
    in property <HomeTile> tile;
    property <length> hero-height: tile.hero.width > 0
        ? min(root.height, root.width * tile.hero.height / tile.hero.width) : 0;

    if tile.hero.width == 0 && tile.hero-blur.width == 0: Rectangle {
        background: @linear-gradient(150deg, tile.art-a 0%, tile.art-b 70%, Theme.bg-base 100%);
    }
    if tile.hero-blur.width > 0: Image {
        width: root.width;
        height: root.height;
        source: tile.hero-blur;
        image-fit: cover;
    }
    // Darkens the blur so widgets and text stay readable on any art.
    if tile.hero-blur.width > 0: Rectangle {
        background: Theme.hero-vignette;
    }
    if tile.hero.width > 0: Image {
        y: 0;
        width: root.width;
        height: hero-height;
        source: tile.hero;
        image-fit: cover;
    }
    // Softens the edge between the sharp hero and the blur below it.
    if tile.hero.width > 0: Rectangle {
        y: hero-height - self.height;
        height: hero-height * 0.45;
        background: @linear-gradient(180deg, transparent 0%, Theme.hero-vignette 100%);
    }
}

// The console icon (24 px) or its monogram, then the name: beside the focused tile.
component TileLabel inherits HorizontalLayout {
    in property <HomeTile> tile;
    spacing: Theme.sp-12;
    alignment: start;
    if tile.kind == TileKind.game && tile.console-icon.width > 0 && tile.console-icon-tint: Image {
        source: tile.console-icon;
        width: 24px * Theme.scale;
        height: self.width;
        y: (parent.height - self.height) / 2;
        colorize: Theme.text-primary;
    }
    if tile.kind == TileKind.game && tile.console-icon.width > 0 && !tile.console-icon-tint: Image {
        source: tile.console-icon;
        width: 24px * Theme.scale;
        height: self.width;
        y: (parent.height - self.height) / 2;
    }
    if tile.kind == TileKind.game && tile.console-icon.width == 0: Rectangle {
        width: monogram.preferred-width + 2 * Theme.sp-8;
        height: 24px * Theme.scale;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-sm;
        border-width: 2px * Theme.scale;
        border-color: Theme.text-secondary;
        monogram := Text {
            text: tile.monogram;
            font-size: 14px * Theme.scale;
            font-weight: Theme.semibold;
            color: Theme.text-primary;
        }
    }
    Text {
        text: tile.title;
        vertical-alignment: center;
        font-size: Theme.body-lg;
        font-weight: Theme.medium;
        color: Theme.text-primary;
        overflow: elide;
    }
}

// Home screen (README §4): top bar, tile row, hero zone for the current tile, widget row.
export component Home inherits Rectangle {
    callback open-settings();
    callback open-placeholder(/* title */ string, /* text */ string);

    property <[HomeTile]> tiles: HomeData.tiles;
    property <HomeZone> zone: HomeZone.row;
    property <int> index: 0;          // current tile
    property <int> top-index: 0;      // 0 Games, 1 Media, 2 Search, 3 Settings
    property <int> hero-index: 0;
    property <int> widget-index: 0;
    property <int> tab: 0;            // 0 Games, 1 Media
    property <HomeTile> current: tiles[index];
    property <bool> current-is-game: current.kind == TileKind.game;
    // Hero buttons: Play [⋯], or Resume, Close and [⋯] for the running game.
    property <int> hero-count: !current-is-game ? 1 : current.running ? 3 : 2;
    property <int> widget-count: 4;

    // Options menu, Properties and the Close game confirmation for the current tile.
    property <bool> menu-open: false;
    property <int> menu-index: 0;
    property <[MenuItem]> menu-items: [
        current.running ? { key: "close", label: "Close game", danger: true } : { key: "play", label: "Play" },
        { key: "controls", label: "Controls for this game" },
        { key: "favorite", label: "Favorite", checked: current.favorite },
        { key: "properties", label: "Properties" },
    ];
    property <bool> properties-open: false;
    property <bool> confirm-open: false;
    property <int> confirm-index: 0;

    // Tile row geometry (README §4, fixed focus anchor): the focused tile stays at safe-x and
    // the row slides by one tile per press, until the last tile is fully visible; from there
    // focus moves the rest of the way. The row never ends before the right safe edge.
    property <length> step: Theme.tile + Theme.tile-gap;
    property <length> row-top: Theme.topbar-height + Theme.sp-24;
    property <length> row-width: max(0, tiles.length - 1) * step + Theme.tile-focused;
    property <length> max-offset: max(0, row-width - (root.width - 2 * Theme.safe-x));
    property <length> row-offset: min(index * step, max-offset);
    property <length> focused-x: Theme.safe-x + index * step - row-offset;
    // Beside the focused tile, in the band below the smaller tiles; under it when the
    // focused tile is too close to the right edge.
    property <length> label-x: focused-x + Theme.tile-focused + Theme.tile-gap;
    property <bool> label-beside: root.width - Theme.safe-x - label-x >= 320px * Theme.scale;
    property <length> hero-top: row-top + Theme.tile-focused + Theme.sp-64;

    // Background layers crossfade (`slow`) whenever the current tile's art changes.
    property <string> backdrop-key: current.id + ":" + current.hero.width + ":" + current.hero-blur.width;
    property <bool> show-a: true;
    property <HomeTile> backdrop-a;
    property <HomeTile> backdrop-b;
    changed backdrop-key => {
        if show-a {
            backdrop-b = current;
        } else {
            backdrop-a = current;
        }
        show-a = !show-a;
    }

    // Focus starts on the first tile: the running game if there is one (Rust puts it first),
    // else the most recently played.
    public function reset() {
        zone = HomeZone.row;
        index = 0;
        tab = 0;
        hero-index = 0;
        widget-index = 0;
        menu-open = false;
        properties-open = false;
        confirm-open = false;
    }

    function activate-current() {
        if current.kind == TileKind.game {
            if current.running {
                Session.resume();
            } else {
                Session.launch(current.id);
            }
        } else if current.kind == TileKind.library {
            open-placeholder("Game Library", "The library grid with console filters arrives in M4.");
        } else if current.kind == TileKind.media {
            open-placeholder("Media", "Movies, shows and music arrive in a later milestone.");
        } else {
            open-settings();
        }
    }

    function set-tab(t: int) {
        tab = t;
        if t == 0 {
            zone = HomeZone.row;
        } else {
            zone = HomeZone.topbar;
            top-index = 1;
        }
    }

    function open-menu() {
        if current.kind == TileKind.game {
            menu-open = true;
            menu-index = 0;
        }
    }

    function ask-close() {
        confirm-open = true;
        confirm-index = 0;
    }

    function handle-menu(action: UiAction) -> bool {
        if action == UiAction.up { menu-index = max(0, menu-index - 1); return true; }
        if action == UiAction.down { menu-index = min(menu-items.length - 1, menu-index + 1); return true; }
        if action == UiAction.back || action == UiAction.options || action == UiAction.left {
            menu-open = false;
            return true;
        }
        if action == UiAction.accept {
            let key = menu-items[menu-index].key;
            if key == "favorite" {
                // Stays open so the check mark visibly flips.
                HomeData.toggle-favorite(current.id);
                return true;
            }
            menu-open = false;
            if key == "close" {
                ask-close();
            } else if key == "play" {
                activate-current();
            } else if key == "controls" {
                HomeData.open-game-controls(current.id);
            } else if key == "properties" {
                HomeData.request-properties(current.id);
                properties-open = true;
            }
            return true;
        }
        true
    }

    function handle-confirm(action: UiAction) -> bool {
        if action == UiAction.left { confirm-index = 0; return true; }
        if action == UiAction.right { confirm-index = 1; return true; }
        if action == UiAction.back { confirm-open = false; return true; }
        if action == UiAction.accept {
            confirm-open = false;
            if confirm-index == 0 { Session.close-game(); }
            return true;
        }
        true
    }

    // Returns true when the action was used.
    public function handle(action: UiAction) -> bool {
        if confirm-open {
            return handle-confirm(action);
        }
        if properties-open {
            if action == UiAction.back || action == UiAction.accept || action == UiAction.options {
                properties-open = false;
            }
            return true;
        }
        if menu-open {
            return handle-menu(action);
        }
        if action == UiAction.prev-tab {
            set-tab(0);
            return true;
        }
        if action == UiAction.next-tab {
            set-tab(1);
            return true;
        }
        if zone == HomeZone.topbar {
            if action == UiAction.left { top-index = max(0, top-index - 1); return true; }
            if action == UiAction.right { top-index = min(3, top-index + 1); return true; }
            if action == UiAction.down && tab == 0 { zone = HomeZone.row; return true; }
            if action == UiAction.back && tab == 0 { zone = HomeZone.row; return true; }
            if action == UiAction.accept {
                if top-index < 2 { set-tab(top-index); }
                if top-index == 2 { HomeData.activated("search", ""); }
                if top-index == 3 { open-settings(); }
                return true;
            }
            return false;
        }
        if zone == HomeZone.row {
            if action == UiAction.left { index = max(0, index - 1); hero-index = 0; return true; }
            if action == UiAction.right { index = min(tiles.length - 1, index + 1); hero-index = 0; return true; }
            if action == UiAction.up { zone = HomeZone.topbar; top-index = tab; return true; }
            if action == UiAction.down { zone = HomeZone.hero; hero-index = 0; return true; }
            if action == UiAction.accept { activate-current(); return true; }
            if action == UiAction.options { open-menu(); return true; }
            return false;
        }
        if zone == HomeZone.hero {
            if action == UiAction.left { hero-index = max(0, hero-index - 1); return true; }
            if action == UiAction.right { hero-index = min(hero-count - 1, hero-index + 1); return true; }
            if action == UiAction.up || action == UiAction.back { zone = HomeZone.row; return true; }
            if action == UiAction.down { zone = HomeZone.widgets; return true; }
            if action == UiAction.accept {
                if hero-index == 0 {
                    activate-current();
                } else if hero-index == hero-count - 1 {
                    open-menu();
                } else {
                    ask-close();
                }
                return true;
            }
            if action == UiAction.options { open-menu(); return true; }
            return false;
        }
        // widgets
        if action == UiAction.left { widget-index = max(0, widget-index - 1); return true; }
        if action == UiAction.right { widget-index = min(widget-count - 1, widget-index + 1); return true; }
        if action == UiAction.up { zone = HomeZone.hero; return true; }
        if action == UiAction.back { zone = HomeZone.row; return true; }
        if action == UiAction.accept { HomeData.activated("widget", widget-index); return true; }
        false
    }

    background: Theme.bg-base;
    clip: true;

    // Background: the current tile's art, crossfading between two layers.
    Backdrop {
        tile: backdrop-a;
        opacity: show-a && tab == 0 ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: ease-in-out; }
    }
    Backdrop {
        tile: backdrop-b;
        opacity: !show-a && tab == 0 ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: ease-in-out; }
    }
    // Plain warm glow for the Media tab.
    Rectangle {
        background: @radial-gradient(circle, Theme.bg-glow 0%, Theme.bg-base 70%);
        opacity: tab == 1 ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: ease-in-out; }
    }
    // Vignettes (top, bottom) and a left shade so hero text stays readable.
    Rectangle {
        height: parent.height * 0.4;
        y: 0;
        background: @linear-gradient(180deg, Theme.hero-vignette 0%, transparent 100%);
    }
    Rectangle {
        height: parent.height * 0.5;
        y: parent.height - self.height;
        background: @linear-gradient(0deg, Theme.hero-vignette 0%, transparent 100%);
    }
    Rectangle {
        width: parent.width * 0.6;
        x: 0;
        background: @linear-gradient(90deg, #00000059 0%, transparent 100%);
    }

    TopBar {
        y: 0;
        width: parent.width;
        tab: tab;
        focus-index: zone == HomeZone.topbar ? top-index : -1;
    }

    // Games tab content.
    Rectangle {
        opacity: tab == 0 ? 1 : 0;
        animate opacity { duration: Theme.base; easing: ease-out; }

        // Tile row
        for tile[i] in tiles: Tile {
            x: Theme.safe-x + i * step + (i > index ? Theme.tile-focused - Theme.tile : 0) - row-offset;
            animate x { duration: Theme.base; easing: ease-out; }
            y: row-top;
            data: tile;
            current: i == index;
            focused: i == index && zone == HomeZone.row;
        }
        if label-beside: TileLabel {
            x: label-x;
            animate x { duration: Theme.base; easing: ease-out; }
            y: row-top + Theme.tile-focused - self.height;
            width: root.width - Theme.safe-x - label-x;
            height: Theme.sp-32;
            tile: current;
        }
        if !label-beside: TileLabel {
            x: max(Theme.safe-x, focused-x + Theme.tile-focused - self.preferred-width);
            y: row-top + Theme.tile-focused + Theme.sp-12;
            width: min(self.preferred-width, root.width - 2 * Theme.safe-x);
            height: Theme.sp-32;
            tile: current;
        }

        // Hero zone
        VerticalLayout {
            x: Theme.safe-x;
            y: hero-top;
            width: parent.width - 2 * Theme.safe-x;
            height: self.preferred-height;
            spacing: Theme.sp-16;
            alignment: start;

            // The game's logo when cached, else its title.
            if current.logo.width > 0: Image {
                height: 140px * Theme.scale;
                width: min(640px * Theme.scale, self.height * current.logo.width / current.logo.height);
                source: current.logo;
                image-fit: contain;
                horizontal-alignment: left;
            }
            if current.logo.width == 0: Text {
                text: current.title;
                font-size: Theme.display;
                font-weight: Theme.semibold;
                color: Theme.text-primary;
            }
            // Console · playtime · last played.
            Text {
                text: current.badge != "" ? current.badge + " · " + current.subtitle : current.subtitle;
                font-size: Theme.body;
                color: Theme.text-secondary;
            }
            HorizontalLayout {
                padding-top: Theme.sp-16;
                spacing: Theme.sp-16;
                alignment: start;
                HButton {
                    primary: true;
                    has-icon: current-is-game;
                    icon: Icons.play;
                    label: current.running ? "Resume" : current-is-game ? "Play" : "Open";
                    focused: zone == HomeZone.hero && hero-index == 0;
                }
                if current.running: HButton {
                    label: "Close";
                    focused: zone == HomeZone.hero && hero-index == 1;
                }
                if current-is-game: HButton {
                    has-icon: true;
                    icon: Icons.ellipsis;
                    focused: zone == HomeZone.hero && hero-index == hero-count - 1;
                }
            }
        }

        // Widget row (fake values). TODO(M3/M4): running game, storage, controllers, media.
        widget-row := HorizontalLayout {
            property <length> widget-width: (self.width - 3 * Theme.sp-24) / widget-count;
            x: Theme.safe-x;
            width: parent.width - 2 * Theme.safe-x;
            height: 200px * Theme.scale;
            y: parent.height - Theme.safe-y - Theme.sp-48 - self.height;
            spacing: Theme.sp-24;
            Widget {
                width: widget-row.widget-width;
                icon: Icons.activity;
                label: "Running now";
                value: Session.active ? Session.title : "Nothing running";
                detail: Session.active ? Session.played : "Pick a game to start";
                focused: zone == HomeZone.widgets && widget-index == 0;
            }
            Widget {
                width: widget-row.widget-width;
                icon: Icons.hard-drive;
                label: "Storage";
                value: "450 GB free";
                detail: "of 1 TB";
                progress: 0.55;
                focused: zone == HomeZone.widgets && widget-index == 1;
            }
            Widget {
                width: widget-row.widget-width;
                icon: Icons.gamepad;
                label: "Controllers";
                value: "1 connected";
                detail: "Wireless controller · 85%";
                focused: zone == HomeZone.widgets && widget-index == 2;
            }
            Widget {
                width: widget-row.widget-width;
                icon: Icons.tv;
                label: "Recently added media";
                value: "3 new";
                detail: "Dune: Part Two and 2 more";
                focused: zone == HomeZone.widgets && widget-index == 3;
            }
        }
    }

    // Media tab placeholder.
    VerticalLayout {
        opacity: tab == 1 ? 1 : 0;
        animate opacity { duration: Theme.base; easing: ease-out; }
        alignment: center;
        spacing: Theme.sp-16;
        Text {
            text: "Media";
            horizontal-alignment: center;
            font-size: Theme.display;
            font-weight: Theme.semibold;
            color: Theme.text-primary;
        }
        Text {
            text: "Movies, shows and music arrive in a later milestone.";
            horizontal-alignment: center;
            font-size: Theme.body-lg;
            color: Theme.text-secondary;
        }
    }

    HintBar {
        x: Theme.safe-x;
        width: parent.width - 2 * Theme.safe-x;
        height: Theme.sp-32;
        y: parent.height - Theme.safe-y - self.height;
        hints: [
            { input: "south", label: "Select" },
            { input: "start", label: "Options" },
            { input: "l1", input2: "r1", label: "Tabs" },
        ];
    }

    // To the right of the focused tile; to its left when it sits at the end of the row.
    if menu-open: OptionsMenu {
        x: root.width - Theme.safe-x - label-x >= self.width ? label-x
            : focused-x - Theme.tile-gap - self.width;
        y: row-top;
        items: menu-items;
        index: menu-index;
    }

    if properties-open: PropertiesPanel {
        data: HomeData.properties;
    }

    if confirm-open: ConfirmDialog {
        heading: "Close " + current.title + "?";
        message: "Unsaved progress in the game will be lost. Playtime is saved.";
        confirm-label: "Close game";
        index: confirm-index;
    }
}
