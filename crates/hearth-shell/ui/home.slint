import { Theme } from "theme.slint";
import { Icons } from "icons.slint";
import { UiAction } from "input.slint";
import { HomeData, HomeTile, TileKind, Session, Status } from "data.slint";
import { Tile } from "components/tile.slint";
import { TopBar } from "components/top_bar.slint";
import { HButton } from "components/button.slint";
import { Widget } from "components/widget.slint";
import { HintBar } from "components/hint_bar.slint";
import { OptionsMenu, MenuItem } from "components/menu.slint";
import { PropertiesPanel } from "components/properties.slint";
import { ConfirmDialog } from "components/dialog.slint";

export enum HomeZone { topbar, row, hero, widgets }

// Plain background: base color with the warm top-left glow (Welcome, games without art).
component Glow inherits Rectangle {
    background: Theme.bg-base;
    Rectangle {
        x: -root.width * 0.4;
        y: -root.height * 0.6;
        width: root.width * 1.2;
        height: self.width;
        background: @radial-gradient(circle, Theme.bg-glow 0%, Theme.bg-base 60%);
    }
}

// One background layer: the hero full-bleed behind the whole screen (cover, centered crop),
// darkened on the left and at the bottom so the logo, text and buttons stay readable. Without
// a hero (Welcome, Library, games without art): the glow.
component Backdrop inherits Rectangle {
    in property <HomeTile> tile;

    if tile.hero.width == 0: Glow { }
    if tile.hero.width > 0: Image {
        width: root.width;
        height: root.height;
        source: tile.hero;
        image-fit: cover;
    }
    // Strong on the left, gone by 60 % of the width.
    if tile.hero.width > 0: Rectangle {
        x: 0;
        width: root.width * 0.6;
        background: @linear-gradient(90deg, #000000E0 0%, #000000A6 45%, transparent 100%);
    }
    if tile.hero.width > 0: Rectangle {
        y: root.height - self.height;
        height: root.height * 0.45;
        background: @linear-gradient(0deg, Theme.hero-vignette 0%, transparent 100%);
    }
    // Light, so the tabs and clock read on bright art.
    if tile.hero.width > 0: Rectangle {
        y: 0;
        height: root.height * 0.25;
        background: @linear-gradient(180deg, #00000059 0%, transparent 100%);
    }
}

// The cell's icon (24 px) then its name, beside the focused cell (and in the collapsed
// header). Games: console icon from the pack (as drawn) or Hearth's glyph (tinted), else a
// monogram. Welcome: the Hearth glyph. Library: the library icon.
component TileLabel inherits HorizontalLayout {
    in property <HomeTile> tile;
    property <bool> game: tile.kind == TileKind.game;
    spacing: Theme.sp-12;
    alignment: start;
    if !game || (tile.console-icon.width > 0 && tile.console-icon-tint): Image {
        source: tile.kind == TileKind.welcome ? Icons.hearth
            : tile.kind == TileKind.library ? Icons.library : tile.console-icon;
        width: 24px * Theme.scale;
        height: self.width;
        y: (parent.height - self.height) / 2;
        colorize: Theme.text-primary;
    }
    if game && tile.console-icon.width > 0 && !tile.console-icon-tint: Image {
        source: tile.console-icon;
        width: 24px * Theme.scale;
        height: self.width;
        y: (parent.height - self.height) / 2;
    }
    if game && tile.console-icon.width == 0: Rectangle {
        width: monogram.preferred-width + 2 * Theme.sp-8;
        height: 24px * Theme.scale;
        y: (parent.height - self.height) / 2;
        border-radius: Theme.radius-sm;
        border-width: 2px * Theme.scale;
        border-color: Theme.text-secondary;
        monogram := Text {
            text: tile.monogram;
            font-size: 14px * Theme.scale;
            font-weight: Theme.semibold;
            color: Theme.text-primary;
        }
    }
    Text {
        text: tile.title;
        vertical-alignment: center;
        font-size: Theme.body-lg;
        font-weight: Theme.medium;
        color: Theme.text-primary;
        overflow: elide;
    }
}

// Home screen (README §4, PS5-style): top bar and cell row over the focused game's hero, its
// logo, details and buttons in the lower half. Down collapses the row into a small header and
// moves the content up; Welcome shows a greeting and the status widgets instead.
export component Home inherits Rectangle {
    callback open-settings();
    callback open-placeholder(/* title */ string, /* text */ string);

    property <[HomeTile]> tiles: HomeData.tiles;
    property <HomeZone> zone: HomeZone.row;
    property <int> index: 0;          // current cell
    property <int> top-index: 0;      // 0 Games, 1 Media, 2 Search, 3 Settings
    property <int> hero-index: 0;
    property <int> widget-index: 0;
    property <int> tab: 0;            // 0 Games, 1 Media
    property <HomeTile> current: tiles[index];
    property <bool> current-is-game: current.kind == TileKind.game;
    property <bool> welcome: current.kind == TileKind.welcome;
    // Buttons: Play [⋯], Resume, Close and [⋯] for the running game, Open for the Library.
    property <int> hero-count: !current-is-game ? 1 : current.running ? 3 : 2;
    property <int> widget-count: 4;
    // Down from the row: the row collapses into a header and the content moves up.
    property <bool> collapsed: zone == HomeZone.hero || zone == HomeZone.widgets;

    // Options menu, Properties and the Close game confirmation for the current cell.
    property <bool> menu-open: false;
    property <int> menu-index: 0;
    property <[MenuItem]> menu-items: [
        current.running ? { key: "close", label: "Close game", danger: true } : { key: "play", label: "Play" },
        { key: "controls", label: "Controls for this game" },
        { key: "favorite", label: "Favorite", checked: current.favorite },
        { key: "properties", label: "Properties" },
    ];
    property <bool> properties-open: false;
    property <bool> confirm-open: false;
    property <int> confirm-index: 0;

    // Row geometry (README §4, fixed focus anchor). The anchor is the second slot: Welcome
    // sits at safe-x (under the "Games" tab) with the first game focused next to it; from
    // there the focused cell stays at the anchor all the way to the last cell, the previous
    // cell fully visible on its left and older ones running off the screen edge.
    property <length> step: Theme.tile + Theme.tile-gap;
    property <length> row-top: Theme.topbar-height + Theme.sp-24;
    property <length> row-offset: max(0, index - 1) * step;
    property <length> focused-x: Theme.safe-x + index * step - row-offset;
    property <length> label-x: focused-x + Theme.tile-focused + Theme.tile-gap;

    // Content block: the logo box (640 × 260) ends at 62 % of the height, in the lower half;
    // collapsing lifts everything by 260.
    property <length> logo-box-width: 640px * Theme.scale;
    property <length> logo-box-height: 260px * Theme.scale;
    property <length> lift: collapsed ? 260px * Theme.scale : 0;
    animate lift { duration: Theme.slow; easing: ease-in-out; }
    property <length> logo-bottom: root.height * 0.62 - lift;
    property <length> meta-y: logo-bottom + Theme.sp-24;
    property <length> buttons-y: meta-y + Theme.body + Theme.sp-32;
    property <length> widgets-y: logo-bottom + Theme.sp-48;

    // Background layers crossfade (`slow`) whenever the current cell's hero changes.
    property <string> backdrop-key: current.id + ":" + current.hero.width;
    property <bool> show-a: true;
    property <HomeTile> backdrop-a;
    property <HomeTile> backdrop-b;
    changed backdrop-key => {
        if show-a {
            backdrop-b = current;
        } else {
            backdrop-a = current;
        }
        show-a = !show-a;
    }

    // Focus on Welcome, or with `focus-game` on the first game (the running one: Rust puts it
    // first) when there is one.
    public function reset(focus-game: bool) {
        zone = HomeZone.row;
        index = focus-game && tiles.length > 2 ? 1 : 0;
        tab = 0;
        hero-index = 0;
        widget-index = 0;
        menu-open = false;
        properties-open = false;
        confirm-open = false;
    }

    function activate-current() {
        if current.kind == TileKind.game {
            if current.running {
                Session.resume();
            } else {
                Session.launch(current.id);
            }
        } else if current.kind == TileKind.library {
            open-placeholder("Game Library", "The library grid with console filters arrives in M4.");
        }
    }

    function set-tab(t: int) {
        tab = t;
        if t == 0 {
            zone = HomeZone.row;
        } else {
            zone = HomeZone.topbar;
            top-index = 1;
        }
    }

    function open-menu() {
        if current.kind == TileKind.game {
            menu-open = true;
            menu-index = 0;
        }
    }

    function ask-close() {
        confirm-open = true;
        confirm-index = 0;
    }

    function handle-menu(action: UiAction) -> bool {
        if action == UiAction.up { menu-index = max(0, menu-index - 1); return true; }
        if action == UiAction.down { menu-index = min(menu-items.length - 1, menu-index + 1); return true; }
        if action == UiAction.back || action == UiAction.options || action == UiAction.left {
            menu-open = false;
            return true;
        }
        if action == UiAction.accept {
            let key = menu-items[menu-index].key;
            if key == "favorite" {
                // Stays open so the check mark visibly flips.
                HomeData.toggle-favorite(current.id);
                return true;
            }
            menu-open = false;
            if key == "close" {
                ask-close();
            } else if key == "play" {
                activate-current();
            } else if key == "controls" {
                HomeData.open-game-controls(current.id);
            } else if key == "properties" {
                HomeData.request-properties(current.id);
                properties-open = true;
            }
            return true;
        }
        true
    }

    function handle-confirm(action: UiAction) -> bool {
        if action == UiAction.left { confirm-index = 0; return true; }
        if action == UiAction.right { confirm-index = 1; return true; }
        if action == UiAction.back { confirm-open = false; return true; }
        if action == UiAction.accept {
            confirm-open = false;
            if confirm-index == 0 { Session.close-game(); }
            return true;
        }
        true
    }

    // Returns true when the action was used.
    public function handle(action: UiAction) -> bool {
        if confirm-open {
            return handle-confirm(action);
        }
        if properties-open {
            if action == UiAction.back || action == UiAction.accept || action == UiAction.options {
                properties-open = false;
            }
            return true;
        }
        if menu-open {
            return handle-menu(action);
        }
        if action == UiAction.prev-tab {
            set-tab(0);
            return true;
        }
        if action == UiAction.next-tab {
            set-tab(1);
            return true;
        }
        if zone == HomeZone.topbar {
            if action == UiAction.left { top-index = max(0, top-index - 1); return true; }
            if action == UiAction.right { top-index = min(3, top-index + 1); return true; }
            if action == UiAction.down && tab == 0 { zone = HomeZone.row; return true; }
            if action == UiAction.back && tab == 0 { zone = HomeZone.row; return true; }
            if action == UiAction.accept {
                if top-index < 2 { set-tab(top-index); }
                if top-index == 2 { HomeData.activated("search", ""); }
                if top-index == 3 { open-settings(); }
                return true;
            }
            return false;
        }
        if zone == HomeZone.row {
            if action == UiAction.left { index = max(0, index - 1); hero-index = 0; return true; }
            if action == UiAction.right { index = min(tiles.length - 1, index + 1); hero-index = 0; return true; }
            if action == UiAction.up { zone = HomeZone.topbar; top-index = tab; return true; }
            if action == UiAction.down {
                if welcome {
                    zone = HomeZone.widgets;
                    widget-index = 0;
                } else {
                    zone = HomeZone.hero;
                    hero-index = 0;
                }
                return true;
            }
            if action == UiAction.accept {
                if welcome {
                    zone = HomeZone.widgets;
                    widget-index = 0;
                } else {
                    activate-current();
                }
                return true;
            }
            if action == UiAction.options { open-menu(); return true; }
            return false;
        }
        if zone == HomeZone.hero {
            if action == UiAction.left { hero-index = max(0, hero-index - 1); return true; }
            if action == UiAction.right { hero-index = min(hero-count - 1, hero-index + 1); return true; }
            if action == UiAction.up || action == UiAction.back { zone = HomeZone.row; return true; }
            if action == UiAction.accept {
                if hero-index == 0 {
                    activate-current();
                } else if hero-index == hero-count - 1 {
                    open-menu();
                } else {
                    ask-close();
                }
                return true;
            }
            if action == UiAction.options { open-menu(); return true; }
            return true;
        }
        // widgets (Welcome only)
        if action == UiAction.left { widget-index = max(0, widget-index - 1); return true; }
        if action == UiAction.right { widget-index = min(widget-count - 1, widget-index + 1); return true; }
        if action == UiAction.up || action == UiAction.back { zone = HomeZone.row; return true; }
        if action == UiAction.accept { HomeData.activated("widget", widget-index); return true; }
        true
    }

    background: Theme.bg-base;
    clip: true;

    // Background: the current cell's hero, crossfading between two layers.
    Backdrop {
        tile: backdrop-a;
        opacity: show-a && tab == 0 ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: ease-in-out; }
    }
    Backdrop {
        tile: backdrop-b;
        opacity: !show-a && tab == 0 ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: ease-in-out; }
    }
    // Plain glow for the Media tab.
    Glow {
        opacity: tab == 1 ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: ease-in-out; }
    }

    // Tabs and row slide up and fade out when collapsed.
    Rectangle {
        y: collapsed ? -(row-top + Theme.tile-focused) : 0;
        animate y { duration: Theme.slow; easing: ease-in-out; }
        opacity: collapsed ? 0 : 1;
        animate opacity { duration: Theme.slow; easing: ease-in-out; }

        TopBar {
            y: 0;
            width: parent.width;
            tab: tab;
            focus-index: zone == HomeZone.topbar ? top-index : -1;
        }

        // Cell row and the label beside the focused cell.
        Rectangle {
            opacity: tab == 0 ? 1 : 0;
            animate opacity { duration: Theme.base; easing: ease-out; }
            for tile[i] in tiles: Tile {
                x: Theme.safe-x + i * step + (i > index ? Theme.tile-focused - Theme.tile : 0) - row-offset;
                animate x { duration: Theme.base; easing: ease-out; }
                y: row-top;
                data: tile;
                current: i == index;
                focused: i == index && zone == HomeZone.row;
            }
            TileLabel {
                x: label-x;
                animate x { duration: Theme.base; easing: ease-out; }
                y: row-top + Theme.tile-focused - self.height;
                width: root.width - Theme.safe-x - label-x;
                height: Theme.sp-32;
                tile: current;
            }
        }
    }

    // Collapsed header, top left: the cell's art, then its icon and name.
    HorizontalLayout {
        x: Theme.safe-x;
        y: Theme.safe-y + (collapsed ? 0 : -Theme.sp-32);
        animate y { duration: Theme.slow; easing: ease-in-out; }
        height: 64px * Theme.scale;
        width: root.width - 2 * Theme.safe-x;
        spacing: Theme.sp-24;
        alignment: start;
        opacity: collapsed && tab == 0 ? 1 : 0;
        animate opacity { duration: Theme.slow; easing: ease-in-out; }
        Rectangle {
            width: self.height;
            border-radius: Theme.radius-md;
            clip: true;
            background: @linear-gradient(135deg, current.art-a 0%, current.art-b 100%);
            if current.art.width > 0: Image {
                width: parent.width;
                height: parent.height;
                source: current.art;
                image-fit: cover;
            }
            if current.art.width == 0 && !current-is-game: Image {
                width: parent.width * 0.5;
                height: self.width;
                source: welcome ? Icons.hearth : Icons.library;
                colorize: Theme.text-primary;
            }
        }
        TileLabel {
            tile: current;
        }
    }

    // Games tab content.
    Rectangle {
        opacity: tab == 0 ? 1 : 0;
        animate opacity { duration: Theme.base; easing: ease-out; }

        // Logo (fit inside the box, bottom-left), else the title on up to two lines; the
        // greeting on Welcome.
        if current.logo.width > 0: Image {
            x: Theme.safe-x;
            y: logo-bottom - logo-box-height;
            width: logo-box-width;
            height: logo-box-height;
            source: current.logo;
            image-fit: contain;
            horizontal-alignment: left;
            vertical-alignment: bottom;
        }
        if current.logo.width == 0: Text {
            x: Theme.safe-x;
            y: logo-bottom - self.height;
            width: min(root.width * 0.6, root.width - 2 * Theme.safe-x);
            height: 2 * 1.3 * Theme.display;
            text: welcome ? Status.greeting : current.title;
            wrap: word-wrap;
            overflow: elide;
            vertical-alignment: bottom;
            font-size: Theme.display;
            font-weight: Theme.semibold;
            color: Theme.text-primary;
        }

        // Console · last played (games), a description (Library).
        if !welcome: Text {
            x: Theme.safe-x;
            y: meta-y;
            width: root.width - 2 * Theme.safe-x;
            text: !current-is-game ? current.subtitle
                : current.last-played != "" ? current.badge + " · " + current.last-played
                : current.badge;
            font-size: Theme.body;
            color: Theme.text-secondary;
        }

        if !welcome: HorizontalLayout {
            x: Theme.safe-x;
            y: buttons-y;
            height: Theme.button-height;
            width: root.width - 2 * Theme.safe-x;
            spacing: Theme.sp-16;
            alignment: start;
            HButton {
                primary: true;
                has-icon: current-is-game;
                icon: Icons.play;
                label: current.running ? "Resume" : current-is-game ? "Play" : "Open";
                focused: zone == HomeZone.hero && hero-index == 0;
            }
            if current.running: HButton {
                label: "Close";
                focused: zone == HomeZone.hero && hero-index == 1;
            }
            if current-is-game: HButton {
                has-icon: true;
                icon: Icons.ellipsis;
                focused: zone == HomeZone.hero && hero-index == hero-count - 1;
            }
        }

        // Playtime pill, right-aligned on the buttons' line.
        if current-is-game: Rectangle {
            x: root.width - Theme.safe-x - self.width;
            y: buttons-y;
            height: Theme.button-height;
            width: pill.preferred-width + 2 * Theme.sp-24;
            border-radius: Theme.radius-md;
            background: Theme.surface;
            pill := HorizontalLayout {
                alignment: center;
                spacing: Theme.sp-12;
                Image {
                    source: Icons.clock;
                    width: Theme.icon-size * 0.75;
                    height: self.width;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.text-primary;
                }
                Text {
                    text: current.played;
                    vertical-alignment: center;
                    font-size: Theme.body-lg;
                    font-weight: Theme.medium;
                    color: Theme.text-primary;
                }
            }
        }

        // Status widgets: Welcome only. TODO(M3/M4): real storage, controllers, media.
        if welcome: widget-row := HorizontalLayout {
            property <length> widget-width: (self.width - 3 * Theme.sp-24) / widget-count;
            x: Theme.safe-x;
            y: widgets-y;
            width: root.width - 2 * Theme.safe-x;
            height: 200px * Theme.scale;
            spacing: Theme.sp-24;
            Widget {
                width: widget-row.widget-width;
                icon: Icons.activity;
                label: "Running now";
                value: Session.active ? Session.title : "Nothing running";
                detail: Session.active ? Session.played : "Pick a game to start";
                focused: zone == HomeZone.widgets && widget-index == 0;
            }
            Widget {
                width: widget-row.widget-width;
                icon: Icons.hard-drive;
                label: "Storage";
                value: "450 GB free";
                detail: "of 1 TB";
                progress: 0.55;
                focused: zone == HomeZone.widgets && widget-index == 1;
            }
            Widget {
                width: widget-row.widget-width;
                icon: Icons.gamepad;
                label: "Controllers";
                value: "1 connected";
                detail: "Wireless controller · 85%";
                focused: zone == HomeZone.widgets && widget-index == 2;
            }
            Widget {
                width: widget-row.widget-width;
                icon: Icons.tv;
                label: "Recently added media";
                value: "3 new";
                detail: "Dune: Part Two and 2 more";
                focused: zone == HomeZone.widgets && widget-index == 3;
            }
        }
    }

    // Media tab placeholder.
    VerticalLayout {
        opacity: tab == 1 ? 1 : 0;
        animate opacity { duration: Theme.base; easing: ease-out; }
        alignment: center;
        spacing: Theme.sp-16;
        Text {
            text: "Media";
            horizontal-alignment: center;
            font-size: Theme.display;
            font-weight: Theme.semibold;
            color: Theme.text-primary;
        }
        Text {
            text: "Movies, shows and music arrive in a later milestone.";
            horizontal-alignment: center;
            font-size: Theme.body-lg;
            color: Theme.text-secondary;
        }
    }

    HintBar {
        x: Theme.safe-x;
        width: parent.width - 2 * Theme.safe-x;
        height: Theme.sp-32;
        y: parent.height - Theme.safe-y - self.height;
        hints: [
            { input: "south", label: "Select" },
            { input: "start", label: "Options" },
            { input: "l1", input2: "r1", label: "Tabs" },
        ];
    }

    // Right of the focused cell; under the buttons when opened from them.
    if menu-open: OptionsMenu {
        x: collapsed ? Theme.safe-x : label-x;
        y: collapsed ? buttons-y + Theme.button-height + Theme.sp-16 : row-top;
        items: menu-items;
        index: menu-index;
    }

    if properties-open: PropertiesPanel {
        data: HomeData.properties;
    }

    if confirm-open: ConfirmDialog {
        heading: "Close " + current.title + "?";
        message: "Unsaved progress in the game will be lost. Playtime is saved.";
        confirm-label: "Close game";
        index: confirm-index;
    }
}
