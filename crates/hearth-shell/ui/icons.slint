// Lucide icons (ISC), see assets/README.md. Tint with `colorize`.

export global Icons {
    out property <image> accessibility: @image-url("../../../assets/icons/accessibility.svg");
    out property <image> activity: @image-url("../../../assets/icons/activity.svg");
    out property <image> battery: @image-url("../../../assets/icons/battery-medium.svg");
    out property <image> battery-low: @image-url("../../../assets/icons/battery-low.svg");
    out property <image> battery-charging: @image-url("../../../assets/icons/battery-charging.svg");
    out property <image> battery-warning: @image-url("../../../assets/icons/battery-warning.svg");
    out property <image> bluetooth: @image-url("../../../assets/icons/bluetooth.svg");
    out property <image> check: @image-url("../../../assets/icons/check.svg");
    out property <image> chevron-right: @image-url("../../../assets/icons/chevron-right.svg");
    out property <image> clock: @image-url("../../../assets/icons/clock.svg");
    out property <image> clapperboard: @image-url("../../../assets/icons/clapperboard.svg");
    out property <image> cpu: @image-url("../../../assets/icons/cpu.svg");
    out property <image> ellipsis: @image-url("../../../assets/icons/ellipsis.svg");
    out property <image> folder: @image-url("../../../assets/icons/folder-open.svg");
    out property <image> file: @image-url("../../../assets/icons/file.svg");
    out property <image> help: @image-url("../../../assets/icons/circle-question-mark.svg");
    out property <image> image: @image-url("../../../assets/icons/image.svg");
    out property <image> image-play: @image-url("../../../assets/icons/image-play.svg");
    out property <image> move-horizontal: @image-url("../../../assets/icons/move-horizontal.svg");
    out property <image> music: @image-url("../../../assets/icons/list-music.svg");
    out property <image> reset: @image-url("../../../assets/icons/rotate-ccw.svg");
    out property <image> gamepad: @image-url("../../../assets/icons/gamepad-2.svg");
    out property <image> hard-drive: @image-url("../../../assets/icons/hard-drive.svg");
    out property <image> library: @image-url("../../../assets/icons/library-big.svg");
    // Hearth's own glyph (not Lucide): a fireplace with a flame, for the Welcome cell.
    out property <image> hearth: @image-url("../../../assets/icons/hearth.svg");
    out property <image> house: @image-url("../../../assets/icons/house.svg");
    out property <image> lock: @image-url("../../../assets/icons/lock.svg");
    out property <image> play: @image-url("../../../assets/icons/play.svg");
    out property <image> power: @image-url("../../../assets/icons/power.svg");
    out property <image> search: @image-url("../../../assets/icons/search.svg");
    out property <image> settings: @image-url("../../../assets/icons/settings.svg");
    out property <image> triangle-alert: @image-url("../../../assets/icons/triangle-alert.svg");
    out property <image> tv: @image-url("../../../assets/icons/tv.svg");
    out property <image> volume: @image-url("../../../assets/icons/volume-2.svg");
    out property <image> wifi: @image-url("../../../assets/icons/wifi.svg");
    out property <image> wifi-high: @image-url("../../../assets/icons/wifi-high.svg");
    out property <image> wifi-low: @image-url("../../../assets/icons/wifi-low.svg");
    out property <image> wifi-zero: @image-url("../../../assets/icons/wifi-zero.svg");

    // Controller icons: Kenney Input Prompts (CC0, assets/icons/controllers/), not Lucide.
    // Filled shapes; tint with `colorize` like the rest.
    out property <image> controller-generic: @image-url("../../../assets/icons/controllers/generic.svg");
    out property <image> controller-disconnected: @image-url("../../../assets/icons/controllers/disconnected.svg");
    // The icon for a pad's `device` (see `bridge::pads::device`): 1 DualSense, 2 DualShock 4,
    // 3 Xbox, 4 Switch Pro, else the generic controller.
    public pure function controller(device: int) -> image {
        if device == 1 { return @image-url("../../../assets/icons/controllers/playstation5.svg"); }
        if device == 2 { return @image-url("../../../assets/icons/controllers/playstation4.svg"); }
        if device == 3 { return @image-url("../../../assets/icons/controllers/xbox.svg"); }
        if device == 4 { return @image-url("../../../assets/icons/controllers/switch_pro.svg"); }
        controller-generic
    }
}
