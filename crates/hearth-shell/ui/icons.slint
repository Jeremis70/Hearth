    out property <image> triangle-alert: @image-url("../../../assets/icons/triangle-alert.svg");
    out property <image> tv: @image-url("../../../assets/icons/tv.svg");
    out property <image> volume: @image-url("../../../assets/icons/volume-2.svg");
    out property <image> wifi: @image-url("../../../assets/icons/wifi.svg");
    out property <image> wifi-high: @image-url("../../../assets/icons/wifi-high.svg");
    out property <image> wifi-low: @image-url("../../../assets/icons/wifi-low.svg");
