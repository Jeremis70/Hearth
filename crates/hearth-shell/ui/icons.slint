    out property <image> ellipsis: @image-url("../../../assets/icons/ellipsis.svg");
    out property <image> folder: @image-url("../../../assets/icons/folder-open.svg");
    out property <image> gamepad: @image-url("../../../assets/icons/gamepad-2.svg");
    out property <image> hard-drive: @image-url("../../../assets/icons/hard-drive.svg");
