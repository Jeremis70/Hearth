// Lucide icons (ISC), see assets/README.md. Tint with `colorize`.

export global Icons {
    out property <image> activity: @image-url("../../../assets/icons/activity.svg");
    out property <image> battery: @image-url("../../../assets/icons/battery-medium.svg");
    out property <image> battery-low: @image-url("../../../assets/icons/battery-low.svg");
    out property <image> battery-charging: @image-url("../../../assets/icons/battery-charging.svg");
