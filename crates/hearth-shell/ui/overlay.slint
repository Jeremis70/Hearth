import { Theme } from "theme.slint";
import { ControlsScreen } from "controls/screen.slint";
import { Icons } from "icons.slint";
import { UiAction, InputMap } from "input.slint";
import { HButton } from "components/button.slint";
import { ConfirmDialog } from "components/dialog.slint";
import { FocusRing } from "components/focus.slint";

component DockButton inherits VerticalLayout {
    in property <image> icon;
    in property <string> label;
    in property <bool> focused;
    spacing: Theme.sp-8;
    alignment: start;
    Rectangle {
        width: Theme.dock-button;
        height: Theme.dock-button;
        border-radius: self.height / 2;
        background: focused ? Theme.surface-raised : Theme.surface;
        Image {
            source: icon;
            width: Theme.icon-size;
            height: Theme.icon-size;
            colorize: Theme.text-primary;
        }
        FocusRing {
            shown: focused;
            radius: parent.height / 2;
        }
    }
    Text {
        text: label;
        horizontal-alignment: center;
        font-size: Theme.caption;
        font-weight: Theme.medium;
        color: focused ? Theme.text-primary : Theme.text-secondary;
    }
}

// In-game overlay (README §4), shown on Guide short press over the frozen game. It is a separate
// transparent window drawn on gamescope's overlay plane; scrim only (no blur: the overlay can't
// read the game's pixels). Controller actions are injected here while it is visible.
export component OverlayWindow inherits Window {
    in property <string> game-title;
    in property <string> badge;
    in property <string> played;
    in property <string> clock;
    // Whether the overlay is open. Set by the session controller together with STEAM_OVERLAY.
    in property <bool> shown: false;

    callback resume();
    callback go-home();
    callback close-game();
    callback dock(/* item */ string);
    callback home-button(/* long */ bool);

    title: "Hearth overlay";
    no-frame: true;
    background: transparent;
    default-font-family: "Manrope";
    preferred-width: 1280px;
    preferred-height: 720px;

    // 0 Resume, 1 Go to Home, 2 Close game, 10.. dock items.
    property <int> item: 0;
    property <bool> confirm-open: false;
    property <int> confirm-index: 0;
    property <[string]> dock-items: ["Home", "Library", "Media", "Volume", "Controls", "Power"];
    // The running game's controls page, over the frozen game.
    property <bool> controls-open: false;

    // Shows the controls page (ControlsData filled by Rust).
    public function open-controls() {
        controls.reset();
        controls-open = true;
    }

    // Globals are per window, so the overlay keeps its own Theme.scale.
    function update-scale() {
        Theme.scale = min(self.width / 1920px, self.height / 1080px);
    }
    init => {
        update-scale();
        scope.focus();
    }
    changed width => { update-scale(); }
    changed height => { update-scale(); }

    // Called each time the overlay opens: Resume is focused.
    public function reset() {
        item = 0;
        confirm-open = false;
        controls-open = false;
        scope.focus();
    }

    function activate() {
        if item == 0 { resume(); }
        if item == 1 { go-home(); }
        if item == 2 { confirm-open = true; confirm-index = 0; }
        if item >= 10 {
            if item == 10 { go-home(); } else { dock(dock-items[item - 10]); }
        }
    }

    public function handle(action: UiAction) -> bool {
        if action == UiAction.home-short || action == UiAction.home-long {
            home-button(action == UiAction.home-long);
            return true;
        }
        if controls-open {
            return controls.handle(action);
        }
        if confirm-open {
            if action == UiAction.left { confirm-index = 0; }
            if action == UiAction.right { confirm-index = 1; }
            if action == UiAction.back { confirm-open = false; }
            if action == UiAction.accept {
                confirm-open = false;
                if confirm-index == 0 { close-game(); }
            }
            return true;
        }
        if action == UiAction.back { resume(); return true; }
        if action == UiAction.accept { activate(); return true; }
        if item == 0 {
            if action == UiAction.down { item = 1; }
            return true;
        }
        if item == 1 || item == 2 {
            if action == UiAction.up { item = 0; }
            if action == UiAction.left { item = 1; }
            if action == UiAction.right { item = 2; }
            if action == UiAction.down { item = 10; }
            return true;
        }
        // dock
        if action == UiAction.left { item = max(10, item - 1); }
        if action == UiAction.right { item = min(10 + dock-items.length - 1, item + 1); }
        if action == UiAction.up { item = 1; }
        true
    }

    scope := FocusScope {
        key-pressed(event) => {
            root.handle(InputMap.from-key(event)) ? EventResult.accept : EventResult.reject
        }

        // Everything is drawn only while `shown`: gamescope may keep compositing this window
        // even when it isn't the active overlay, so a hidden overlay must be fully transparent.
        Rectangle {
            opacity: shown ? 1 : 0;
            animate opacity { duration: shown ? Theme.overlay-in : Theme.overlay-out; easing: ease-out; }

            Rectangle {
                background: Theme.scrim;
            }

            // Clock, top right.
            Text {
                x: parent.width - Theme.safe-x - self.width;
                y: Theme.safe-y;
                text: clock;
                font-size: Theme.tab;
                font-weight: Theme.semibold;
                letter-spacing: Theme.tab-tracking;
                color: Theme.text-primary;
            }

            // Now playing card.
            Rectangle {
                x: Theme.safe-x;
                y: parent.height - Theme.safe-y - Theme.dock-height - Theme.sp-64 - self.height;
                width: 640px * Theme.scale;
                height: card.preferred-height;
                border-radius: Theme.radius-lg;
                background: Theme.surface-raised;

                card := VerticalLayout {
                    padding: Theme.sp-32;
                    spacing: Theme.sp-12;
                    Text {
                        text: "NOW PLAYING";
                        font-size: Theme.caption;
                        font-weight: Theme.semibold;
                        letter-spacing: Theme.tab-tracking;
                        color: Theme.accent;
                    }
                    Text {
                        text: game-title;
                        font-size: Theme.title;
                        font-weight: Theme.semibold;
                        color: Theme.text-primary;
                        wrap: word-wrap;
                    }
                    Text {
                        text: badge + " · " + played;
                        font-size: Theme.body;
                        color: Theme.text-secondary;
                    }
                    VerticalLayout {
                        padding-top: Theme.sp-16;
                        spacing: Theme.sp-16;
                        HButton {
                            primary: true;
                            has-icon: true;
                            icon: Icons.play;
                            label: "Resume";
                            focused: item == 0;
                        }
                        HorizontalLayout {
                            spacing: Theme.sp-16;
                            alignment: start;
                            HButton {
                                label: "Go to Home";
                                focused: item == 1;
                            }
                            HButton {
                                label: "Close game";
                                focused: item == 2;
                            }
                        }
                    }
                }
            }

            // Dock. TODO(M3+): Library, Media, Volume, Controllers and Power do something.
            HorizontalLayout {
                y: parent.height - Theme.safe-y - self.height;
                height: Theme.dock-height + Theme.sp-32;
                alignment: center;
                spacing: Theme.sp-48;
                DockButton { icon: Icons.house; label: "Home"; focused: item == 10; }
                DockButton { icon: Icons.library; label: "Library"; focused: item == 11; }
                DockButton { icon: Icons.clapperboard; label: "Media"; focused: item == 12; }
                DockButton { icon: Icons.volume; label: "Volume"; focused: item == 13; }
                DockButton { icon: Icons.gamepad; label: "Controls"; focused: item == 14; }
                DockButton { icon: Icons.power; label: "Power"; focused: item == 15; }
            }

            controls := ControlsScreen {
                visible: controls-open;
                background: Theme.bg-base.with-alpha(0.94);
                close => { controls-open = false; }
            }

            if confirm-open: ConfirmDialog {
                heading: "Close " + game-title + "?";
                message: "Unsaved progress in the game will be lost. Playtime is saved.";
                confirm-label: "Close game";
                index: confirm-index;
            }
        }
    }
}
