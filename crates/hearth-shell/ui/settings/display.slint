import { Theme } from "../theme.slint";
import { Icons } from "../icons.slint";
import { SettingsData, AudioRow } from "../data.slint";
import { ListRow } from "../components/list_row.slint";

component RowFocus inherits Rectangle {
    in property <int> index;
    in property <length> top;
    x: 0;
    y: top + max(0, index) * (Theme.row-height + Theme.row-gap);
    animate y { duration: Theme.fast; easing: ease-out; }
    height: Theme.row-height;
    border-radius: Theme.radius-md;
    background: Theme.surface-raised;
    border-width: Theme.focus-ring-width;
    border-color: Theme.focus-ring;
    drop-shadow-blur: Theme.focus-glow-radius;
    drop-shadow-color: Theme.focus-glow;
    opacity: index >= 0 ? 1 : 0;
    animate opacity { duration: Theme.fast; easing: ease-out; }
}

// A volume: the level as a bar and a number.
component LevelBar inherits Rectangle {
    in property <int> value;
    width: 220px * Theme.scale;
    height: 6px * Theme.scale;
    border-radius: self.height / 2;
    background: Theme.divider;
    Rectangle {
        x: 0;
        width: parent.width * value / 100;
        animate width { duration: Theme.fast; easing: ease-out; }
        border-radius: parent.border-radius;
        background: Theme.accent;
    }
}

component AudioRowView inherits Rectangle {
    in property <AudioRow> data;
    in property <bool> show-divider;
    height: Theme.row-height;
    ListRow {
        width: parent.width;
        icon: data.key == "animated_art" ? Icons.image-play
            : data.key == "reduce_motion" ? Icons.accessibility : Icons.volume;
        label: data.label;
        value: data.slider ? data.value : data.detail != "" ? data.detail : (data.on ? "On" : "Off");
        value-color: !data.slider && data.on && data.detail == "" ? Theme.accent : Theme.text-secondary;
        show-divider: show-divider;
    }
    if data.slider: LevelBar {
        x: parent.width - Theme.sp-24 - Theme.sp-64 - self.width;
        y: (parent.height - self.height) / 2;
        value: data.value;
    }
}

// Display & sound pane: "Console icons" and "UI sounds" (SettingsData.display-items), each
// opening a list of installed packs plus "Hearth default" (SettingsData.pack-choices), then
// Hearth's volumes and music options (SettingsData.audio-rows).
export component DisplayPane inherits Rectangle {
    in property <int> focus-index: -1;    // -1 when focus is in the sidebar
    in property <bool> picking: false;    // the pack list is shown
    in property <string> picking-label;

    property <length> list-top: picking ? heading.height + Theme.sp-24 : 0;

    heading := Text {
        x: 0;
        y: 0;
        visible: picking;
        text: picking-label;
        font-size: Theme.heading;
        font-weight: Theme.semibold;
        color: Theme.text-primary;
    }

    RowFocus {
        width: parent.width;
        top: list-top;
        index: focus-index;
    }

    if !picking: Rectangle {
        for item[i] in SettingsData.display-items: ListRow {
            x: 0;
            y: i * (Theme.row-height + Theme.row-gap);
            width: parent.width;
            icon: item.key == "console_icons" ? Icons.gamepad : Icons.volume;
            label: item.label;
            value: item.status;
            trailing-icon: Icons.chevron-right;
            has-trailing-icon: true;
            show-divider: i != focus-index && i + 1 != focus-index;
        }
        for row[j] in SettingsData.audio-rows: AudioRowView {
            property <int> i: SettingsData.display-items.length + j;
            x: 0;
            y: i * (Theme.row-height + Theme.row-gap);
            width: parent.width;
            data: row;
            show-divider: i != focus-index && i + 1 != focus-index;
        }
    }

    if picking: Rectangle {
        y: list-top;
        for choice[i] in SettingsData.pack-choices: ListRow {
            x: 0;
            y: i * (Theme.row-height + Theme.row-gap);
            width: parent.width;
            icon: Icons.folder;
            label: choice.label;
            value: choice.status;
            trailing-icon: Icons.check;
            has-trailing-icon: choice.key == SettingsData.pack-selected;
            show-divider: i != focus-index && i + 1 != focus-index;
        }
    }
}
